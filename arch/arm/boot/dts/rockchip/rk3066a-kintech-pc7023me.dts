// };

&usbphy {
	status = "okay";
};

&usb_otg {
	status = "okay";
	// vbus-supply = <&vdd3>;
	vbus-supply = <&vcc_otg>;
};

&wdt {
	status = "okay";
};

&mmc0 {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	card-detect-delay = <400>;
	cd-gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&mmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus4>;
	pinctrl-names = "default";
	max-frequency = <150000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vcc_18_wifi>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	sd-uhs-ddr50;
	sd-uhs-sdr104;

	brcmf: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		// brcm,drive-strength = <5>;
		// interrupt-parent = <&gpio3>;
		// interrupts = <RK_PD2 IRQ_TYPE_LEVEL_HIGH>;
		// interrupt-names = "host-wake";
		// pinctrl-names = "default";
		// pinctrl-0 = <&wifi_host_wake>;
	};
};

&nfc {
	#address-cells = <1>;
	#size-cells = <0>;
	// status = "okay";
	nand@0 {
		// Flash Size: 8192MB // Block Size: 4096KB // Page Size: 16KB // ECC Bits: 40 // Access Time: 30 // Flash CS: <0> <1>
		reg = <0>, <1>;
		// label = "rk29xxnand"; TODO when works
		label = "uwu";
		nand-bus-width = <8>;
		nand-ecc-mode = "hw";
		nand-ecc-step-size = <1024>;
		nand-ecc-strength = <40>;
		nand-is-boot-medium;
		rockchip,boot-blks = <8>;
		rockchip,boot-ecc-strength = <24>;
	};
};

